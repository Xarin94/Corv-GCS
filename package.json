{
  "name": "corv-gcs",
  "version": "1.8.0",
  "description": "CORV SYSTEMS Ground Control Station",
  "main": "main.js",
  "scripts": {
    "start": "electron .",
    "postinstall": "electron-builder install-app-deps",
    "models": "node scripts/gen-models.js",
    "test:hgt": "node scripts/test-hgt-worker.js",
    "test:render": "node scripts/test-render-backend.js",
    "test:architecture": "node scripts/test-render-architecture.js",
    "measure:runtime": "node scripts/measure-runtime.js",
    "build": "electron-builder --win --linux",
    "build:win": "electron-builder --win",
    "build:linux": "electron-builder --linux",
    "build:mac": "electron-builder --mac"
  },
  "build": {
    "appId": "com.corvsystems.gcs",
    "productName": "CORV GCS",
    "afterPack": "./scripts/afterPack.js",
    "asar": true,
    "asarUnpack": [
      "**/*.node",
      "lidar-worker.js",
      "lidar-core.js",
      "**/node_modules/@serialport/**",
      "**/node_modules/serialport/**"
    ],
    "files": [
      "**/*",
      "!.git/**",
      "!.claude/**",
      "!dist/**",
      "!build/**",
      "!topo/**",
      "!topography/**",
      "!scripts/**",
      "!prototypes/**",
      "!data/**",
      "!docs/**"
    ],
    "win": {
      "icon": "build/icon.ico",
      "target": [
        "nsis"
      ]
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "installerSidebar": null
    },
    "mac": {
      "icon": "assets/icons/icon-512x512.png",
      "category": "public.app-category.utilities",
      "target": [
        {
          "target": "dmg",
          "arch": [
            "arm64",
            "x64"
          ]
        }
      ]
    },
    "dmg": {
      "artifactName": "${productName}-${version}-${arch}.${ext}"
    },
    "linux": {
      "icon": "build/icon256.png",
      "target": [
        "AppImage",
        "deb"
      ],
      "category": "Utility"
    }
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Xarin94/Corv-GCS.git"
  },
  "keywords": [],
  "author": "CORV SYSTEMS <info@corvsystems.com>",
  "license": "Apache-2.0",
  "type": "commonjs",
  "bugs": {
    "url": "https://github.com/Xarin94/Corv-GCS/issues"
  },
  "homepage": "https://github.com/Xarin94/Corv-GCS#readme",
  "devDependencies": {
    "electron": "^39.2.7",
    "electron-builder": "^26.8.1"
  },
  "dependencies": {
    "node-mavlink": "^2.3.0",
    "serialport": "^13.0.0"
  }
}
