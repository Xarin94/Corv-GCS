# CORV GCS - helicopter SITL (ArduCopter on the 'heli' model)
# Values of ArduPilot's Tools/autotest/default_params/copter-heli.parm. On the raw firmware
# defaults FRAME_CLASS is a quad ("Check frame class and type") and it does not arm.
# The rotor runs on the interlock: channel 7 high (a joystick, or RC_CHANNELS_OVERRIDE).

FRAME_CLASS      6

H_COL_MAX        1740
H_COL_MIN        1460
H_COL_ANG_MAX    12
H_COL_ANG_MIN    -2
H_RSC_MODE       2
H_RSC_SETPOINT   66
SERVO8_MIN       1000
SERVO8_MAX       2000
RPM1_TYPE        10
# The interlock on channel 7, low in the simulator at start (8 is high: it would not arm)
RC8_OPTION       0
RC7_OPTION       32

ATC_INPUT_TC     0.20
ATC_ANG_PIT_P    6
ATC_ANG_RLL_P    4
ATC_ANG_YAW_P    5.8
ATC_RAT_PIT_D    0.002
ATC_RAT_PIT_FLTD 0
ATC_RAT_PIT_FLTE 20
ATC_RAT_PIT_FLTT 20
ATC_RAT_PIT_I    0.095
ATC_RAT_PIT_ILMI 0.1
ATC_RAT_PIT_IMAX 0.4
ATC_RAT_PIT_P    0.024
ATC_RAT_PIT_FF   0.19
ATC_RAT_RLL_D    0.0001
ATC_RAT_RLL_FLTD 0
ATC_RAT_RLL_FLTE 20
ATC_RAT_RLL_FLTT 20
ATC_RAT_RLL_I    0.105
ATC_RAT_RLL_ILMI 0.1
ATC_RAT_RLL_IMAX 0.4
ATC_RAT_RLL_P    0.06
ATC_RAT_RLL_FF   0.21
ATC_RAT_YAW_D    0.0039
ATC_RAT_YAW_FLTD 0
ATC_RAT_YAW_FLTE 0
ATC_RAT_YAW_FLTT 20
ATC_RAT_YAW_I    0.0245
ATC_RAT_YAW_ILMI 0
ATC_RAT_YAW_IMAX 1
ATC_RAT_YAW_P    0.24685
ATC_RAT_YAW_FF   0
ATC_ACCEL_P_MAX  60000
ATC_ACCEL_R_MAX  60000
ATC_ACCEL_Y_MAX  60000
ATC_HOVR_ROL_TRM 320
IM_ACRO_COL_EXP  0.2
PSC_VELXY_D      0.5

# --- RC calibration ---
RC1_MIN 1000
RC1_MAX 2000
RC1_TRIM 1500
RC2_MIN 1000
RC2_MAX 2000
RC2_TRIM 1500
RC3_MIN 1000
RC3_MAX 2000
RC3_TRIM 1500
RC4_MIN 1000
RC4_MAX 2000
RC4_TRIM 1500
RC5_MIN 1000
RC5_MAX 2000
RC5_TRIM 1500
RC6_MIN 1000
RC6_MAX 2000
RC6_TRIM 1500
RC7_MIN 1000
RC7_MAX 2000
RC7_TRIM 1500
RC8_MIN 1000
RC8_MAX 2000
RC8_TRIM 1500

# --- small INS offsets so both IMUs count as calibrated, and the simulated compasses' own offsets ---
INS_ACCOFFS_X  0.001
INS_ACCOFFS_Y  0.001
INS_ACCOFFS_Z  0.001
INS_ACCSCAL_X  1.001
INS_ACCSCAL_Y  1.001
INS_ACCSCAL_Z  1.001
INS_ACC2OFFS_X  0.001
INS_ACC2OFFS_Y  0.001
INS_ACC2OFFS_Z  0.001
INS_ACC2SCAL_X  1.001
INS_ACC2SCAL_Y  1.001
INS_ACC2SCAL_Z  1.001
COMPASS_OFS_X  5
COMPASS_OFS_Y  13
COMPASS_OFS_Z  -18
COMPASS_OFS2_X  5
COMPASS_OFS2_Y  13
COMPASS_OFS2_Z  -18
COMPASS_OFS3_X  5
COMPASS_OFS3_Y  13
COMPASS_OFS3_Z  -18

# --- battery ---
BATT_MONITOR     4
