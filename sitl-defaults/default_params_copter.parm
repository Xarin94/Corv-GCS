# CORV GCS — classic SITL quad defaults
# Base: ArduPilot Tools/autotest/default_params/copter.parm (the CI tune),
# plus a calmer pitch/roll D-term and zero simulated vibration/noise.
# Without this file the binary flies on raw firmware defaults, which buzz
# on pitch and roll with the ideal SITL frame.

FRAME_CLASS     1
FRAME_TYPE      0
FS_THR_ENABLE   1

# --- RC calibration ---
RC1_MIN 1000
RC1_MAX 2000
RC1_TRIM 1500
RC2_MIN 1000
RC2_MAX 2000
RC2_TRIM 1500
RC3_MIN 1000
RC3_MAX 2000
RC3_TRIM 1500
RC4_MIN 1000
RC4_MAX 2000
RC4_TRIM 1500
RC5_MIN 1000
RC5_MAX 2000
RC5_TRIM 1500
RC6_MIN 1000
RC6_MAX 2000
RC6_TRIM 1500
RC7_MIN 1000
RC7_MAX 2000
RC7_TRIM 1500
RC7_OPTION 7
RC8_MIN 1000
RC8_MAX 2000
RC8_TRIM 1500

# --- small INS offsets so the IMU counts as calibrated ---
INS_ACCOFFS_X   0.001
INS_ACCOFFS_Y   0.001
INS_ACCOFFS_Z   0.001
INS_ACCSCAL_X   1.001
INS_ACCSCAL_Y   1.001
INS_ACCSCAL_Z   1.001
INS_ACC2OFFS_X  0.001
INS_ACC2OFFS_Y  0.001
INS_ACC2OFFS_Z  0.001
INS_ACC2SCAL_X  1.001
INS_ACC2SCAL_Y  1.001
INS_ACC2SCAL_Z  1.001
COMPASS_OFS_X   5
COMPASS_OFS_Y   13
COMPASS_OFS_Z   -18
COMPASS_OFS2_X  5
COMPASS_OFS2_Y  13
COMPASS_OFS2_Z  -18
COMPASS_OFS3_X  5
COMPASS_OFS3_Y  13
COMPASS_OFS3_Z  -18

# --- battery / motors (autotest reference values, 3S) ---
BATT_MONITOR     4
MOT_THST_EXPO    0.65
MOT_THST_HOVER   0.39
MOT_BAT_VOLT_MIN 9.6
MOT_BAT_VOLT_MAX 12.8

# --- attitude: calm the pitch/roll buzz ---
# Halved rate D-term and tighter D filtering vs firmware defaults; SMAX
# caps the slew the rate loop can demand from the motors.
ATC_RAT_RLL_D    0.0018
ATC_RAT_PIT_D    0.0018
ATC_RAT_RLL_FLTD 10
ATC_RAT_PIT_FLTD 10
ATC_RAT_RLL_SMAX 50
ATC_RAT_PIT_SMAX 50
ATC_RAT_YAW_P    0.3
ATC_RAT_YAW_I    0.02

# --- simulated vibration / sensor noise: LOW ---
# Motor vibration off, just a whisper of sensor noise so the HUD looks
# alive. Set the RND values to 0 for perfectly clean gyros/accels.
SIM_VIB_MOT_MAX  0
SIM_VIB_MOT_MASK 0
SIM_VIB_FREQ_X   0
SIM_VIB_FREQ_Y   0
SIM_VIB_FREQ_Z   0
SIM_GYR1_RND     0.05    # deg/s
SIM_GYR2_RND     0.05
SIM_ACC1_RND     0.2     # m/s^2
SIM_ACC2_RND     0.2
SIM_BARO_RND     0
