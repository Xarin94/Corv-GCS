# CORV GCS — 12S high-speed quadcopter defaults (SITL model: X:quad12s.json)
# Passed via --defaults at SITL launch. Where ArduPilot 4.7+ renamed a
# parameter, both spellings are listed: the firmware ignores unknown names
# with a console warning, so the file works on stable and latest alike.

FRAME_CLASS      1
FRAME_TYPE       1       # X frame — must match the SITL "X" physics model

# --- RC calibration (standard SITL) ---
RC1_MIN 1000
RC1_MAX 2000
RC1_TRIM 1500
RC2_MIN 1000
RC2_MAX 2000
RC2_TRIM 1500
RC3_MIN 1000
RC3_MAX 2000
RC3_TRIM 1500
RC4_MIN 1000
RC4_MAX 2000
RC4_TRIM 1500
RC5_MIN 1000
RC5_MAX 2000
RC5_TRIM 1500
RC6_MIN 1000
RC6_MAX 2000
RC6_TRIM 1500
RC7_MIN 1000
RC7_MAX 2000
RC7_TRIM 1500
RC8_MIN 1000
RC8_MAX 2000
RC8_TRIM 1500

# --- small INS offsets so the IMU counts as calibrated ---
INS_ACCOFFS_X   0.001
INS_ACCOFFS_Y   0.001
INS_ACCOFFS_Z   0.001
INS_ACCSCAL_X   1.001
INS_ACCSCAL_Y   1.001
INS_ACCSCAL_Z   1.001
INS_ACC2OFFS_X  0.001
INS_ACC2OFFS_Y  0.001
INS_ACC2OFFS_Z  0.001
INS_ACC2SCAL_X  1.001
INS_ACC2SCAL_Y  1.001
INS_ACC2SCAL_Z  1.001
COMPASS_OFS_X   5
COMPASS_OFS_Y   13
COMPASS_OFS_Z   -18
COMPASS_OFS2_X  5
COMPASS_OFS2_Y  13
COMPASS_OFS2_Z  -18
COMPASS_OFS3_X  5
COMPASS_OFS3_Y  13
COMPASS_OFS3_Z  -18

# --- battery: 12S (4.2 V/cell full, 3.3 V/cell empty) ---
BATT_MONITOR     4
SIM_BATT_VOLTAGE 50.4
BATT_CAPACITY    6000
MOT_BAT_VOLT_MAX 50.4
MOT_BAT_VOLT_MIN 39.6
BATT_ARM_VOLT    45.6
BATT_LOW_VOLT    43.2
BATT_CRT_VOLT    42.0

# --- motors ---
MOT_PWM_MIN      1000
MOT_PWM_MAX      2000
MOT_THST_EXPO    0.70
MOT_THST_HOVER   0.12
MOT_HOVER_LEARN  2
MOT_SPIN_ARM     0.03
MOT_SPIN_MIN     0.03
MOT_SPOOL_TIME   0.25

# --- attitude tune: smooth gains for an overpowered frame (T/W ~ 5) ---
# Default rate PIDs are far too hot for this much authority and would
# reintroduce the pitch/roll buzz the classic quad shows.
INS_GYRO_FILTER  40
INS_ACCEL_FILTER 20
ATC_INPUT_TC     0.12
ATC_ANG_RLL_P    8
ATC_ANG_PIT_P    8
ATC_ANG_YAW_P    5
ATC_RAT_RLL_P    0.08
ATC_RAT_RLL_I    0.08
ATC_RAT_RLL_D    0.002
ATC_RAT_RLL_FLTD 20
ATC_RAT_RLL_FLTT 20
ATC_RAT_RLL_SMAX 50
ATC_RAT_PIT_P    0.08
ATC_RAT_PIT_I    0.08
ATC_RAT_PIT_D    0.002
ATC_RAT_PIT_FLTD 20
ATC_RAT_PIT_FLTT 20
ATC_RAT_PIT_SMAX 50
ATC_RAT_YAW_P    0.4
ATC_RAT_YAW_I    0.04
ATC_RAT_YAW_FLTE 2
ATC_ACCEL_R_MAX  160000
ATC_ACCEL_P_MAX  160000
ATC_ACCEL_Y_MAX  40000
ATC_THR_MIX_MAN  0.5

# --- speed envelope: high-speed cruise ---
ANGLE_MAX        6500    # centideg (<=4.6) — 65 deg lean
ATC_ANGLE_MAX    65      # deg (4.7+)
PILOT_SPEED_UP   500     # cm/s (<=4.6)
PILOT_SPD_UP     5       # m/s (4.7+)
PILOT_SPEED_DN   300
PILOT_SPD_DN     3
PILOT_Y_RATE     200
WPNAV_SPEED      2500    # cm/s (<=4.6) — 25 m/s in AUTO
WP_SPD           25      # m/s (4.7+)
WPNAV_ACCEL      800
WP_ACC           8
WPNAV_SPEED_UP   500
WP_SPD_UP        5
WPNAV_SPEED_DN   300
WP_SPD_DN        3
WPNAV_JERK       5
WP_JERK          5
LOIT_SPEED       2500
LOIT_SPEED_MS    25
LOIT_ACC_MAX     800
LOIT_ACC_MAX_M   8
LOIT_BRK_ACCEL   600
LOIT_BRK_ACC_M   6
LOIT_BRK_JERK    800
LOIT_BRK_JRK_M   8
RTL_SPEED        1000
RTL_SPEED_MS     10
RTL_ALT          3000
RTL_ALT_M        30

# --- simulated vibration / sensor noise: LOW ---
# Motor vibration off, just a whisper of sensor noise so the HUD looks alive.
# Set the RND values to 0 for perfectly clean gyros/accels.
SIM_VIB_MOT_MAX  0
SIM_VIB_MOT_MASK 0
SIM_VIB_FREQ_X   0
SIM_VIB_FREQ_Y   0
SIM_VIB_FREQ_Z   0
SIM_GYR1_RND     0.05    # deg/s
SIM_GYR2_RND     0.05
SIM_ACC1_RND     0.2     # m/s^2
SIM_ACC2_RND     0.2
SIM_BARO_RND     0
