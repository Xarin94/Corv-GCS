# ============================================================
# Fast plane — ArduPlane SITL defaults for the 'plane-jet:jet600.json' model
# 22 kg, 20 kgf thrust, low-drag airframe (jet600.json): top speed ~660 km/h,
# cruise 83 m/s (300 km/h), 600 km/h on command. ArduPlane 4.7 names.
# ============================================================

# --- Airspeed envelope (m/s): 300 km/h cruise, up to 612 km/h commanded
#     (DO_CHANGE_SPEED / SPD in the command bar), stall of the jet ~25 m/s ---
AIRSPEED_MIN         32
AIRSPEED_MAX         170
AIRSPEED_CRUISE      83
ARSPD_USE            1
# Gain scheduling reference — the controllers were tuned at this speed.
# Leaving the 15 m/s default scales the gains by (15/83)^2 at cruise.
SCALING_SPEED        83
STALL_PREVENTION     1

# --- Throttle ---
THR_MIN              0
THR_MAX              100
# ~21 % holds 83 m/s with the jet600.json drag (58 % with the stock drag)
TRIM_THROTTLE        21
THR_SLEWRATE         40
THR_PASS_STAB        0

# --- TECS: a heavy airframe climbs and slows down gently ---
TECS_CLMB_MAX        12
TECS_SINK_MIN        3.5
TECS_SINK_MAX        12
TECS_SPDWEIGHT       1.0
TECS_TIME_CONST      6
TECS_THR_DAMP        0.6
TECS_PTCH_DAMP       0.4
TECS_RLL2THR         8
TECS_LAND_ARSPD      36
TECS_LAND_SINK       1.5

# --- Attitude limits (degrees) ---
PTCH_LIM_MAX_DEG     22
PTCH_LIM_MIN_DEG     -20
ROLL_LIMIT_DEG       60
LAND_PITCH_DEG       2

# --- Rate controllers (upstream plane-jet tune) ---
RLL2SRV_RMAX         70
RLL2SRV_TCONST       0.6
RLL_RATE_P           0.13
RLL_RATE_I           0.5
RLL_RATE_D           0.0
RLL_RATE_FF          0.57
RLL_RATE_IMAX        0.666667
PTCH2SRV_RLL         1.04
PTCH2SRV_TCONST      0.6
PTCH_RATE_P          0.09
PTCH_RATE_I          0.5
PTCH_RATE_D          0.0
PTCH_RATE_FF         0.69
PTCH_RATE_IMAX       0.666667
YAW_RATE_ENABLE      0

# --- Navigation: turn radius at 83 m/s and 45 deg bank is ~700 m ---
NAVL1_PERIOD         22
NAVL1_DAMPING        0.75
WP_RADIUS            250
WP_LOITER_RAD        450
RTL_RADIUS           450

# --- Take-off / landing ---
TKOFF_ROTATE_SPD     34
TKOFF_THR_MAX        100
# 0: throttle from standstill. The jet has no catapult, and a ground-speed
# gate (it was 20 m/s) held the throttle at zero forever on the runway.
TKOFF_THR_MINSPD     0
TKOFF_LVL_ALT        30
TKOFF_ALT            120
TKOFF_PLIM_SEC       3
LAND_FLARE_SEC       2.5
LAND_FLARE_ALT       6
FBWB_CLIMB_RATE      6

# --- RTL ---
RTL_ALTITUDE         300

# --- Battery 6S ---
BATT_MONITOR         4
SIM_BATT_VOLTAGE     25.2

# --- Sensor calibration the simulator expects (same block as the copter
#     defaults). Without it ArduPlane reports "3D Accel calibration needed"
#     and keeps the AHRS flagged unhealthy. ---
INS_ACCOFFS_X        0.001
INS_ACCOFFS_Y        0.001
INS_ACCOFFS_Z        0.001
INS_ACCSCAL_X        1.001
INS_ACCSCAL_Y        1.001
INS_ACCSCAL_Z        1.001
INS_ACC2OFFS_X       0.001
INS_ACC2OFFS_Y       0.001
INS_ACC2OFFS_Z       0.001
INS_ACC2SCAL_X       1.001
INS_ACC2SCAL_Y       1.001
INS_ACC2SCAL_Z       1.001
COMPASS_OFS_X        5
COMPASS_OFS_Y        13
COMPASS_OFS_Z        -18
COMPASS_OFS2_X       5
COMPASS_OFS2_Y       13
COMPASS_OFS2_Z       -18
COMPASS_OFS3_X       5
COMPASS_OFS3_Y       13
COMPASS_OFS3_Z       -18

# --- Estimator: EKF3 only ---
EK2_ENABLE           0
EK3_ENABLE           1
AHRS_EKF_TYPE        3

# --- Arming relaxed for SITL ---
ARMING_CHECK         0
