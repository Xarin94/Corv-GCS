# CORV GCS — 12S high-speed quadcopter SITL frame model
# Loaded with --model X:quad12s.json (file must sit in the SITL working dir).
# Physics: ~2 kg rig, thrust/weight ≈ 12.5. Terminal speed scales with
# sqrt(tan(lean)): 40 m/s at 45° → ~111 m/s (400 km/h) at ~83°, where only
# ~7.8x hover thrust is needed vs 12.5 available. That headroom matters:
# with the previous 33 m/s fit the throttle saturated near 82° (voltage sag
# + momentum drag), capping speed at ~320 km/h and making the altitude and
# attitude loops chatter — the "vibration" seen at high speed. Top speed in
# Loiter/Guided/Auto is capped at 111 m/s by LOIT_SPEED/WPNAV_SPEED.

{
    # total vehicle mass in kg
    "mass" : 2.0,

    # vehicle diameter in metres (motor-to-motor diagonal)
    "diagonal_size" : 0.40,

    # reference test: constant-speed flight in zero wind, used to fit drag
    "refSpd" : 40.0,     # m/s at 45° → ~111 m/s at ~83°
    "refAngle" : 45.0,   # degrees
    "refVoltage" : 46.0, # volts (12S under load)
    "refCurrent" : 28.0, # amps
    "refAlt" : 600,      # metres AMSL
    "refTempC" : 25,     # degrees C
    "refBatRes" : 0.005, # ohms — low-IR race pack, limits sag at ~10x hover power

    # full battery voltage: 12S x 4.2 V
    "maxVoltage" : 50.4,

    # full battery capacity, Ah (0 = unlimited)
    "battCapacityAh" : 16.0,

    # MOT_THST_EXPO
    "propExpo" : 0.7,

    # approximate maximum yaw rate in deg/sec
    "refRotRate" : 400,

    # hover throttle 0..1 — T/W ~ 12.5, needed to hold level flight at 85°
    "hoverThrOut" : 0.08,

    # MOT_PWM_MIN / MOT_PWM_MAX
    "pwmMin" : 1000,
    "pwmMax" : 2000,

    # MOT_SPIN_MIN / MOT_SPIN_MAX
    "spin_min" : 0.03,
    "spin_max" : 0.95,

    # maximum motor slew rate, 0 = disabled
    "slew_max" : 0,

    # total effective disc area, sq m (4 x 8" rotors)
    "disc_area" : 0.32,

    # momentum drag coefficient (ratio vs ducted rotor of same disc area)
    "mdrag_coef" : 0.10,

    # number of motors
    "num_motors" : 4
}
